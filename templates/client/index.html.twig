{% extends 'base.html.twig' %}

{% block title %}Prendre un rendez-vous
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-8">
				<div class="card">
					<div class="card-header">
						<h3 class="text-center">Prendre un Rendez-vous</h3>
					</div>
					<div class="card-body">
						<p class="text-center mb-4">Remplissez le formulaire ci-dessous</p>

						{% for message in app.flashes('success') %}
							<div class="alert alert-success">{{ message }}</div>
						{% endfor %}

						{{ form_start(form) }}
						<div class="row mb-3">
							<div class="col-md-6">
								{{ form_label(form.specialite, 'Spécialité') }}
								{{ form_widget(form.specialite, {'attr': {'class': 'form-control'}}) }}
							</div>
							<div class="col-md-6">
								{{ form_label(form.prestation, 'Type de prestation') }}
								{{ form_widget(form.prestation, {'attr': {'class': 'form-control'}}) }}
							</div>
						</div>

						<div class="row mb-3">
							<div class="col-md-6">
								{{ form_label(form.dateHeure, 'Date') }}
								{{ form_widget(form.dateHeure, {'attr': {'class': 'form-control'}}) }}
							</div>
						</div>

						<div class="text-center">
							<button type="submit" class="btn btn-primary btn-lg">
								Enregistrer le rendez-vous
							</button>
						</div>
						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
