{% extends 'base.html.twig' %}

{% block title %}Gestion des rendez-vous
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<h1 class="mb-4 text-center">Gestion des rendez-vous</h1>

		{% for message in app.flashes('success') %}
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}

		{% for message in app.flashes('warning') %}
			<div class="alert alert-warning alert-dismissible fade show" role="alert">
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}

		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead class="table-dark">
					<tr>
						<th>Patient</th>
						<th>Date et heure</th>
						<th>Prestation</th>
						<th>Spécialité</th>
						<th>Statut</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for rdv in rendezVous %}
						<tr>
							<td>{{ rdv.patient.nom }}
								{{ rdv.patient.prenom }}</td>
							<td>{{ rdv.dateHeure|date('d/m/Y H:i') }}</td>
							<td>
								<span class="badge bg-info">
									{{ rdv.prestation.value|capitalize }}
								</span>
							</td>
							<td>
								<span class="badge bg-secondary">
									{{ rdv.specialite.value|capitalize }}
								</span>
							</td>
							<td>
								<span class="badge bg-{{
										                                rdv.statut.value == 'validee' ? 'success' :
										                                rdv.statut.value == 'refusee' ? 'danger' :
										                                rdv.statut.value == 'annulee' ? 'secondary' : 'warning'
										                            }}">
									{{ rdv.statut.value|replace({'_': ' '})|title }}
								</span>
							</td>
							<td>
								{% if rdv.statut.value == 'en_attente' %}
									<div class="btn-group" role="group">
										<a href="{{ path('app_secretaire_valider', {id: rdv.id}) }}" class="btn btn-success btn-sm">
											<i class="bi bi-check-circle"></i>
											Valider
										</a>
										<a href="{{ path('app_secretaire_refuser', {id: rdv.id}) }}" class="btn btn-danger btn-sm">
											<i class="bi bi-x-circle"></i>
											Refuser
										</a>
									</div>
								{% else %}
									<span class="text-muted">Action effectuée</span>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-4">
								Aucun rendez-vous enregistré
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
