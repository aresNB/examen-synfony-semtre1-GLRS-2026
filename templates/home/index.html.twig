{% extends 'base.html.twig' %}

{% block title %}Accueil - Clinique GLRS
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-8 text-center">
				<h1 class="display-4 mb-4">Bienvenue à la Clinique GLRS</h1>
				<p class="lead mb-4">Prenez rendez-vous en ligne ou gérez les rendez-vous en tant que secrétaire</p>

				<div class="row mt-5">
					<div class="col-md-6 mb-4">
						<div class="card h-100">
							<div class="card-body">
								<i class="bi bi-calendar-plus" style="font-size: 3rem; color: #667eea;"></i>
								<h3 class="card-title mt-3">Prendre un rendez-vous</h3>
								<p class="card-text">Prenez rendez-vous en ligne facilement et rapidement.</p>
								<a href="{{ path('app_client_rendezvous') }}" class="btn btn-primary">
									Prendre RDV
								</a>
							</div>
						</div>
					</div>
					<div class="col-md-6 mb-4">
						<div class="card h-100">
							<div class="card-body">
								<i class="bi bi-clipboard-check" style="font-size: 3rem; color: #764ba2;"></i>
								<h3 class="card-title mt-3">Espace Secrétaire</h3>
								<p class="card-text">Gérez et validez les rendez-vous des patients.</p>
								<a href="{{ path('app_secretaire') }}" class="btn btn-primary">
									Accéder
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
